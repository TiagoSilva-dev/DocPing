# Apenas desenvolvimento local. Copie para .env e substitua os valores change-me.
# Nunca envie .env ao Git nem utilize estes exemplos em produção.
WEB_ORIGIN=http://localhost:5173
API_HOST_PORT=8080
MYSQL_DATABASE=docping
MYSQL_USER=docping
MYSQL_PASSWORD=change-me-local-mysql
MYSQL_ROOT_PASSWORD=change-me-local-mysql-root
S3_BUCKET=docping
S3_ACCESS_KEY=docping-local
S3_SECRET_KEY=change-me-local-s3-secret
SMTP_FROM=docping@localhost
SMTP_REQUIRE_TLS=false
CLIENT_LIMIT=30
MAX_UPLOAD_BYTES=20971520
MAX_ORG_STORAGE_BYTES=1073741824
MAX_REQUEST_STORAGE_BYTES=524288000

# Para executar Go no host com os serviços do Compose, use estes endereços:
# APP_ENV=development
# PORT=8080
# STORE_DRIVER=mysql
# MYSQL_DSN=docping:change-me-local-mysql@tcp(127.0.0.1:3306)/docping?parseTime=true&loc=UTC
# S3_ENDPOINT=http://127.0.0.1:9000
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_REQUIRE_TLS=false
# CLAMAV_ADDRESS=127.0.0.1:3310
# A porta ClamAV não é publicada por padrão. Prefira rodar a API no Compose.

# Desenvolvimento sem Docker: deve ser escolhido explicitamente, sem fallback.
# APP_ENV=development STORE_DRIVER=json DATA_DIR=../../.local-data
# ALLOW_UNSCANNED_UPLOADS=true (somente arquivos sintéticos; impede alegar varredura)

# Produção: configure diretamente no ambiente/secrets, não neste arquivo.
# APP_ENV=production
# WEB_ORIGIN=https://app.seu-dominio.com.br
# STORE_DRIVER=mysql
# MYSQL_DSN=<dsn com parseTime=true&tls=true obrigatório>
# S3_ENDPOINT=https://<endpoint privado compatível S3>
# SMTP_HOST=<smtp transacional>
# SMTP_PORT=587
# SMTP_USERNAME=<usuario>
# SMTP_PASSWORD=<segredo>
# SMTP_FROM=documentos@seu-dominio.com.br
# SMTP_REQUIRE_TLS=true
# CLAMAV_ADDRESS=<scanner privado>:3310
# ALLOW_UNSCANNED_UPLOADS=false
